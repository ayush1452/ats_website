# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (leave blank for the device-persisted deterministic demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional semantic analysis. All calls remain server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional live billing. Without these values, billing shows a truthful unconfigured state.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CAREER_MONTHLY=
STRIPE_PRICE_CAREER_ANNUAL=
STRIPE_PRICE_TEAMS_MONTHLY=
STRIPE_PRICE_TEAMS_ANNUAL=

# Optional OAuth and public links are configured in the corresponding provider dashboards.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# Only set true after verifying the configured AI provider's data controls.
AI_DATA_TRAINING_DISABLED=false
NEXT_PUBLIC_AI_DATA_TRAINING_DISABLED=false

# Optional production anonymous-scan abuse protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_HASH_SALT=

# Local seed account. Never reuse these values in production.
DEMO_EMAIL=alex.morgan@example.test
DEMO_PASSWORD=ResumePilotDemo!2026
